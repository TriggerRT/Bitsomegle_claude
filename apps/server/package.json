{
  "name": "@bitsomeggle/server",
  "version": "0.0.0",
  "private": true,
  "description": "Matchmaking and signaling server",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --conditions=source src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@bitsomeggle/shared": "0.0.0",
    "pino": "10.4.0",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15"
  }
}
