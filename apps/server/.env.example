# Copy to .env for local development. Never commit .env.
# `npm run dev` reads .env automatically. Without one, the values below are the defaults.

# Port for the HTTP + WebSocket server (Render sets this automatically in production).
PORT=3001

# Web app address(es) allowed to connect, comma separated. Required in production.
CORS_ORIGIN=http://localhost:5173

# Daily opening windows in Indian Standard Time, comma separated, 24-hour clock.
# A window may run past midnight. Leave empty to be always open.
# Example: OPEN_WINDOWS=21:00-00:30
OPEN_WINDOWS=

# Soft cap on simultaneous connections.
MAX_CLIENTS=1000

# silent, fatal, error, warn, info, debug or trace
LOG_LEVEL=info

# --- Only needed once the server is deployed (docs/DEPLOYMENT.md) ---

# Cloudflare TURN key, for calls between networks that block direct connections.
# Set both or neither. Without them calls use STUN only, which is fine on one laptop.
# TURN_KEY_API_TOKEN is a SECRET: it belongs in the host's dashboard, never in git.
TURN_KEY_ID=
TURN_KEY_API_TOKEN=

# Most connections allowed from one IP address at the same time. 0 = no limit.
MAX_CLIENTS_PER_IP=0

# Request header in which the hosting proxy reports the visitor's real IP address
# (on Render: true-client-ip). Leave empty when there is no proxy, as on your laptop.
CLIENT_IP_HEADER=
