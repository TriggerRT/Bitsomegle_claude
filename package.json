{
  "name": "bitsomeggle",
  "private": true,
  "description": "Anonymous one-to-one video chat for BITS Pilani students",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/shared",
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @bitsomeggle/server",
    "dev:web": "npm run dev -w @bitsomeggle/web",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
